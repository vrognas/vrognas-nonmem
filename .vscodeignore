# devtime sources / tests — we ship out/extension.js + media/<panel>/client.js
# (both bundled by esbuild; webview-src is the input)
src/**
test/**
webview-src/**
.vscode/**
.vscode-test/**

# build / lint / format config
.github/**
esbuild.cjs
eslint.config.*
.prettierrc*
prettier.config.*
tsconfig.json
vitest.config.*
.gitattributes
.gitignore

# dev docs / scratch — runtime gets README + CHANGELOG + LICENSE
AGENTS.md
CLAUDE.md
docs/**
empirical-models/**
.remember/**

# local state / scratch / secrets — never ship (vsce ignores .gitignore once a
# .vscodeignore exists, so these must be repeated here)
.claude/**
.tmp-*.mod
.env
.env.*
.DS_Store
coverage/**
*.log
.vrognas-nonmem/**
.positron-nonmem/**

# build artefacts and lockfiles
*.vsix
package-lock.json
**/*.test.ts
**/*.tsbuildinfo
# source maps: production esbuild emits none, but stale dev-build maps linger
# on disk — never ship them
**/*.map
