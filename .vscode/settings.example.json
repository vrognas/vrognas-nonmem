// Copy this file to .vscode/settings.json and adjust to taste.
// settings.json is gitignored so per-developer config stays local.
//
// All keys live under the `nonmem.*` namespace. Defaults match
// pharmacometric convention; tune to your group's preferences. Search
// "nonmem" in the Settings UI for the full description of each.
//
// Connection details are NOT configured here — the extension expects to
// run inside a Positron Remote SSH session against the NONMEM host; no
// hostname, user, port, or identity file lives in workspace settings.
{
  // Fit Inspector thresholds
  "nonmem.shrinkageWarnPct": 30,
  "nonmem.shrinkageBorderlineWarnPct": 20,
  "nonmem.rseWarnPct": 100,
  "nonmem.rseThetaWarnPct": 30,
  "nonmem.rseOmegaWarnPct": 50,
  "nonmem.pValWarnThreshold": 0.1,
  "nonmem.pValBadThreshold": 0.05,
  "nonmem.corrRedFlagThreshold": 0.95,
  "nonmem.corrWarnThreshold": 0.9,
  "nonmem.condNumberBadThreshold": 1000,
  "nonmem.condNumberWarnThreshold": 100,

  // Run Lineage view
  "nonmem.lineageOfvThreshold": 3.84
}
