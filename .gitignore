# user-supplied workspace settings + launch configs (may contain hostnames
# or per-user paths that fall under privacy hygiene)
.vscode/settings.json
.vscode/launch.json
!.vscode/settings.example.json
!.vscode/launch.example.json

# extension run mirror (per-workspace, never committed)
.vrognas-nonmem/
# (legacy name, kept while M0-era runs may still mirror to the old path)
.positron-nonmem/

# claude-code session state (handoff notes between conversations)
.remember/
.claude/

# local empirical-probe scratch (probe models live on the host, not here)
.tmp-*.mod
empirical-models/

# editor cruft
*.log
.tsbuildinfo

# bundled webview assets — regenerated at package time via vscode:prepublish
# (esbuild builds webview-src/<panel>/client.ts -> media/<panel>/client.js)
media/lineage/client.js
